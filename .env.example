# ─────────────────────────────────────────────────────────────
# Bridgecodes website configuration
# Copy to .env.local (local) or set in your hosting dashboard.
# Values are read at BUILD time for static pages, so set them
# before running `npm run build`. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Site identity ────────────────────────────────────────────
# Official production domain, no trailing slash. Until this is set,
# production builds are marked noindex and the sitemap is not published.
SITE_URL=

# ── Public contact details (leave blank until confirmed) ─────
# Anything left blank is simply not displayed on the site.
CONTACT_EMAIL=
SUPPORT_EMAIL=
CONTACT_PHONE=
# Single line, e.g. "Street, City, Country"
REGISTERED_ADDRESS=
COMPANY_REGISTRATION_NUMBER=

# ── Official social profiles (blank = icon hidden) ───────────
SOCIAL_LINKEDIN=
SOCIAL_X=
SOCIAL_GITHUB=
SOCIAL_YOUTUBE=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=

# ── Legal settings (shown on the legal pages) ────────────────
LEGAL_EFFECTIVE_DATE=            # e.g. 2026-11-01
LEGAL_GOVERNING_JURISDICTION=    # e.g. "the laws of <country/state>"
LEGAL_PRIVACY_CONTACT_EMAIL=     # falls back to CONTACT_EMAIL
LEGAL_REFUND_WINDOW_DAYS=        # number; blank = "to be confirmed"
# Set to "true" ONLY after a qualified lawyer has reviewed every legal page.
# This removes the "draft – not legally reviewed" banner.
LEGAL_REVIEWED=false

# ── Enquiry delivery (contact, support and bug-report forms) ─
# Option A – email via Resend (https://resend.com). Server-side only.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=              # a sender verified with Resend, e.g. "Bridgecodes <no-reply@your-domain>"
ENQUIRY_TO_EMAIL=                # inbox that receives enquiries
SUPPORT_TO_EMAIL=                # optional separate inbox for support/bug reports

# Option B – append submissions to a JSONL file on a persistent disk
# (VPS / Docker volume). Not suitable for serverless file systems.
ENQUIRY_STORE_DIR=

# ── Spam protection ──────────────────────────────────────────
# Secret used to sign form tokens. Generate with: openssl rand -hex 32
FORM_TOKEN_SECRET=
# Optional Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional, privacy-friendly) ───────────────────
# Plausible (cookieless). Leave blank to load no analytics at all.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js
# "true" shows a consent banner and loads analytics only after opt-in.
ANALYTICS_REQUIRES_CONSENT=false

# ── Development only ─────────────────────────────────────────
# Show products marked published:false in the catalogue (for previewing).
PREVIEW_UNPUBLISHED_PRODUCTS=false
